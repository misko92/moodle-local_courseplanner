{{!
    @template local_courseplanner/page_header

    Page heading with a button that restarts the page's user tour (local_courseplanner/showtour).

    Example context (json):
    {"heading": "Calendar builder", "tourname": "local_courseplanner_builder"}
}}
<div class="local-courseplanner-pageheader">
    <h2>{{heading}}</h2>
    {{#tourname}}
    <button type="button" id="local-courseplanner-showtour" class="btn btn-sm btn-outline-info local-courseplanner-showtour"
        data-tour-name="{{tourname}}">{{#str}}showtourbtn, local_courseplanner{{/str}}</button>
    {{/tourname}}
</div>
