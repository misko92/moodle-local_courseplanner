{{!
    @template local_courseplanner/action_form

    A one-button form that POSTs an action back to the current page, optionally after a confirmation
    dialog (handled by local_courseplanner/confirmaction).

    Example context (json):
    {
        "action": "deletecalendar",
        "label": "Delete",
        "btnclass": "btn-outline-danger",
        "sesskey": "abc",
        "params": [{"name": "calendarid", "value": 3}],
        "confirm": {"message": "Delete this calendar?", "title": "Confirm", "action": "Delete", "style": "delete"}
    }
}}
<form method="post" class="local-courseplanner-inline-form{{#formclass}} {{.}}{{/formclass}}"{{#confirm}}
    data-cc-confirm="{{message}}" data-cc-confirm-title="{{title}}" data-cc-confirm-action="{{action}}"
    data-cc-confirm-style="{{style}}"{{/confirm}}>
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="action" value="{{action}}">
    {{#params}}<input type="hidden" name="{{name}}" value="{{value}}">{{/params}}
    <button type="submit" class="btn {{btnclass}}{{^btnclass}}btn-outline-secondary{{/btnclass}}">{{label}}</button>
</form>
