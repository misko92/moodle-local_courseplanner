{{!
    @template local_courseplanner/view_page

    The student view of a course calendar: its title, the course intro texts and the grid.

    Example context (json):
    {
        "label": "2026-27",
        "intro": "<p>Welcome</p>",
        "links": "",
        "hasintro": true,
        "grid": {"hasrows": false},
        "empty": true
    }
}}
<div class="local-courseplanner-shell mb-3">{{label}}</div>
{{#hasintro}}
<div class="local-courseplanner-course-intro local-courseplanner-course-intro-grid">
    {{#intro}}<div class="local-courseplanner-course-intro-panel">{{{intro}}}</div>{{/intro}}
    {{#links}}<div class="local-courseplanner-course-intro-panel">{{{links}}}</div>{{/links}}
</div>
{{/hasintro}}
{{#empty}}
<div class="alert alert-info">{{#str}}previewempty, local_courseplanner{{/str}}</div>
{{/empty}}
{{#grid}}{{> local_courseplanner/calendar_grid}}{{/grid}}
