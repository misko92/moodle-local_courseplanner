{{!
    @template local_courseplanner/calendar_grid

    A calendar's week-by-week grid. With "editable", each column heading and content cell gets edit
    buttons (handled by local_courseplanner/builder) and content cells can be dragged onto each other.

    Example context (json):
    {
        "calendarid": 3,
        "editable": true,
        "hasrows": true,
        "sesskey": "abc",
        "rows": [
            {"isheader": true, "nearest": false, "cells": [
                {"row": 0, "col": 0, "isheader": true, "html": "Week"},
                {"row": 0, "col": 1, "isheader": true, "html": "Day A", "meta": "Monday · Lecture", "editheader": true}
            ]},
            {"isheader": false, "nearest": true, "cells": [
                {"row": 1, "col": 0, "isweeklabel": true, "html": "Week 1<br>Sep 7"},
                {"row": 1, "col": 1, "istopic": true, "topicid": 5, "topicheading": "", "html": "<p>Atoms</p>",
                 "editcell": true, "today": false}
            ]}
        ]
    }
}}
{{#hasrows}}
<div class="local-courseplanner-gridwrap{{^editable}} local-courseplanner-embed{{/editable}}">
<table class="table table-bordered local-courseplanner-grid{{^editable}} local-courseplanner-preview{{/editable}}"
    id="local-courseplanner-grid" data-calendarid="{{calendarid}}">
    {{#rows}}
    <tr{{#nearest}} class="local-courseplanner-nearest-row"{{/nearest}}>
        {{#cells}}
        {{#isheader}}<th scope="col"{{/isheader}}{{^isheader}}<td{{/isheader}}
            class="local-courseplanner-grid-cell{{#isblank}} local-courseplanner-blank-cell{{/isblank}}{{!
            }}{{#highlighted}} local-courseplanner-highlighted{{/highlighted}}{{!
            }}{{#vcentred}} local-courseplanner-vcentred{{/vcentred}}{{!
            }}{{#today}} local-courseplanner-today-cell{{/today}}{{!
            }}{{#isheader}}{{^editable}} local-courseplanner-preview-header{{/editable}}{{/isheader}}"
            data-cc-row="{{row}}" data-cc-col="{{col}}"{{#editcell}} data-cc-editable="1"{{/editcell}}>
            {{#editheader}}
            <div class="local-courseplanner-cell-actions">
                <button type="button" class="btn btn-sm btn-link p-0" data-modalform="local_courseplanner\form\header_form"
                    data-modalform-args="{{headerargs}}" data-modalform-title="{{#str}}editcolumn, local_courseplanner{{/str}}"
                    title="{{#str}}editcolumn, local_courseplanner{{/str}}" aria-label="{{#str}}editcolumn, local_courseplanner{{/str}}">
                    {{#pix}}t/edit, core{{/pix}}
                </button>
                <form method="post" class="d-inline local-courseplanner-delete-column-form"
                    data-cc-confirm="{{#str}}deletecolumnconfirm, local_courseplanner{{/str}}"
                    data-cc-confirm-title="{{#str}}confirm, core{{/str}}"
                    data-cc-confirm-action="{{#str}}deletecolumnbtn, local_courseplanner{{/str}}"
                    data-cc-confirm-style="delete">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="deletecolumn">
                    <input type="hidden" name="colnum" value="{{col}}">
                    <button type="submit" class="btn btn-sm btn-link p-0 text-danger"
                        title="{{#str}}deletecolumnbtn, local_courseplanner{{/str}}"
                        aria-label="{{#str}}deletecolumnbtn, local_courseplanner{{/str}}">
                        {{#pix}}t/delete, core{{/pix}}
                    </button>
                </form>
            </div>
            {{/editheader}}
            {{#cellheading}}<div class="local-courseplanner-cellheading">{{{cellheading}}}</div>{{/cellheading}}
            {{#istopic}}{{{topicheading}}}{{/istopic}}
            {{#html}}
            <div class="{{#isheader}}local-courseplanner-readonly-cell{{/isheader}}{{!
                }}{{#isweeklabel}}local-courseplanner-readonly-cell{{/isweeklabel}}{{!
                }}{{#isblank}}local-courseplanner-blank-label{{/isblank}}{{!
                }}{{#istopic}}local-courseplanner-topic-preview{{/istopic}}{{!
                }}{{^isheader}}{{^isweeklabel}}{{^isblank}}{{^istopic}}local-courseplanner-text-preview{{/istopic}}{{/isblank}}{{/isweeklabel}}{{/isheader}}">{{{html}}}</div>
            {{/html}}
            {{#meta}}<div class="local-courseplanner-header-meta">{{meta}}</div>{{/meta}}
            {{#editcell}}
            <div class="local-courseplanner-cell-actions">
                <button type="button" class="btn btn-sm btn-link p-0" data-modalform="local_courseplanner\form\cell_form"
                    data-modalform-args="{{cellargs}}" data-modalform-title="{{#str}}editcellsummary, local_courseplanner{{/str}}">
                    {{#str}}editcellsummary, local_courseplanner{{/str}}
                </button>
                {{#istopic}}
                <button type="button" class="btn btn-sm btn-link p-0" data-action="edit-topic" data-modalform="local_courseplanner\form\topic_form"
                    data-modalform-args="{{topicargs}}" data-modalform-title="{{#str}}sharedtopiceditorheading, local_courseplanner{{/str}}">
                    {{#str}}edittopicbutton, local_courseplanner{{/str}}
                </button>
                {{/istopic}}
            </div>
            {{/editcell}}
        {{#isheader}}</th>{{/isheader}}{{^isheader}}</td>{{/isheader}}
        {{/cells}}
    </tr>
    {{/rows}}
</table>
</div>
{{/hasrows}}
